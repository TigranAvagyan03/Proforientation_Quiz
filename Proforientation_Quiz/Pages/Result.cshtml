@page
@model Proforientation_Quiz.Web.Pages.ResultModel
@{
    ViewData["Title"] = "Результат";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @if (Model.Profession != null)
            {
                <div class="card shadow-lg">
                    <div class="window-titlebar">
                        <span class="dot"></span>
                        <span class="title-text">quiz / result</span>
                        <form asp-page="/Account/Logout" method="post" style="margin-left:auto;">
                            <button type="submit" class="logout-link">Выйти</button>
                        </form>
                    </div>
                    <div class="card-body text-center">
                        <p class="text-muted mb-2">// ваша профессия</p>
                        <h1 class="display-5 fw-bold mb-3" style="color:var(--accent) !important; letter-spacing:1px;">@Model.Profession.Title</h1>
                        <p class="text-muted mb-4">@Model.Profession.Description</p>
                        <p class="mb-4">@Model.Profession.RecommendationText</p>
                        <form method="post" asp-page-handler="Restart">
                            <button type="submit" class="btn btn-outline-primary btn-lg">Пройти заново</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <p class="text-center text-muted">Не удалось определить профессию.</p>
            }
        </div>
    </div>
</div>